{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pano",
  "version": "0.1.0",
  "identifier": "com.codex.pano",
  "build": {
    "beforeDevCommand": "python -m uvicorn app.main:app --host 127.0.0.1 --port 8000",
    "devUrl": "http://127.0.0.1:8000",
    "frontendDist": "../app/static"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Pano",
        "width": 1180,
        "height": 820,
        "minWidth": 900,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": "default-src 'self' http://127.0.0.1:8000 data: blob:; img-src 'self' data: blob:; connect-src http://127.0.0.1:8000; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.ico"
    ]
  }
}
